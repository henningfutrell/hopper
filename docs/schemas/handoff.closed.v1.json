{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "handoffId": {
      "type": "string"
    },
    "end": {
      "type": "string",
      "enum": [
        "run_again",
        "cleared",
        "finished",
        "superseded",
        "item_closed",
        "job_gone"
      ]
    },
    "nextJobId": {
      "type": "string"
    }
  },
