{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bastion": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "box": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "stopped",
        "expired",
        "job-ended",
        "failed"
      ]
    },
    "by": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    }
  },
  "required": [
    "bastion",
    "template",
    "box",
    "reason"
  ],
  "additionalProperties": false
}
