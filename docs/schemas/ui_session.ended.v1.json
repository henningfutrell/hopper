{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "expired-idle",
        "expired-absolute",
        "refresh-refused",
        "provider-unreachable",
        "realm-changed",
        "logout"
      ]
    },
    "realm": {
      "type": "string"
    }
  },
  "required": [
    "reason",
    "realm"
  ],
  "additionalProperties": false
}
