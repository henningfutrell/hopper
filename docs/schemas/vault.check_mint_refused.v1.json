{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mint": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "aws",
            "kube"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "read",
            "write",
            "sync",
            "apply",
            "observe"
          ]
        },
        "asset": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "cluster",
                "namespace",
                "argocd-app",
                "terraform-workspace",
                "aws-account",
                "aws-role",
                "database"
              ]
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "operation",
        "asset"
      ],
      "additionalProperties": false
    },
    "template": {
      "type": "string"
    },
    "check": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    }
  },
  "required": [
    "mint",
    "template",
    "check",
    "reason"
  ],
  "additionalProperties": false
}
