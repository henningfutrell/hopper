{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pickId": {
      "type": "string"
    },
    "point": {
      "type": "string",
      "enum": [
        "question-risk",
        "failure-assessment",
        "lane-count",
        "job-machine",
        "intake-order",
        "merge-order",
        "intake-trust",
        "intake-kind",
        "sandbox-request",
        "question-answer"
      ]
    },
    "by": {
      "type": "string",
      "const": "jev"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "pick": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "error": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "credentials",
          "destructive",
          "publish",
          "pay",
          "permissions",
          "ci",
          "data",
          "other"
        ]
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "off",
        "shadow",
        "active"
      ]
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "applied": {
      "type": "boolean"
    },
    "notApplied": {
      "type": "string",
      "enum": [
        "shadow",
        "below_threshold",
        "consequential",
        "no_pick",
        "too_late"
      ]
    },
    "consequential": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questionId": {
      "type": "string"
    },
    "machineId": {
      "type": "string"
    }
  },
  "required": [
    "pickId",
    "point",
    "by",
    "options",
    "mode",
    "threshold",
    "applied"
  ],
  "additionalProperties": false
}
