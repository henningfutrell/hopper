{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "endedAt": {
      "type": "string"
    },
    "graceMinutes": {
      "type": "number"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "machineId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "scratch_dir",
              "job_worktree",
              "job_scope",
              "container_runtime"
            ]
          },
          "locator": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "live",
              "failed"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "machineId",
          "kind",
          "locator",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "endedAt",
    "graceMinutes",
    "entries"
  ],
  "additionalProperties": false
}
