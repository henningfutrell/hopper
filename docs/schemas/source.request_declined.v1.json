{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "author": {
      "type": "string"
    },
    "person": {
      "type": "string"
    },
    "via": {
      "type": "string",
      "enum": [
        "ui",
        "cli",
        "api"
      ]
    },
    "choice": {
      "type": "string",
      "enum": [
        "close",
        "open"
      ]
    }
  },
  "required": [
    "source",
    "key",
    "hash",
    "author"
  ],
  "additionalProperties": false
}
