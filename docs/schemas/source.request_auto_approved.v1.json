{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "author": {
      "type": "string"
    },
    "rule": {
      "type": "string",
      "enum": [
        "reopened",
        "author",
        "app",
        "high-label"
      ]
    },
    "actor": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "author",
              "labelled",
              "assigned",
              "edited"
            ]
          },
          "login": {
            "type": "string"
          },
          "app": {
            "type": "string"
          },
          "trusted": {
            "type": "boolean"
          }
        },
        "required": [
          "role",
          "trusted"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source",
    "key",
    "hash",
    "author",
    "rule",
    "actor",
    "actors"
  ],
  "additionalProperties": false
}
