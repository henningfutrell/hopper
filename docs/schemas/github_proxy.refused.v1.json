{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "as": {
      "type": "string"
    },
    "own": {
      "type": "boolean"
    },
    "forUser": {
      "type": "string"
    },
    "job": {
      "type": "string"
    },
    "op": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    },
    "shrunk": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "from": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "to": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "against": {
            "type": "string",
            "enum": [
              "base",
              "head"
            ]
          }
        },
        "required": [
          "path",
          "from",
          "to",
          "against"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "requestId",
    "reason"
  ],
  "additionalProperties": false
}
