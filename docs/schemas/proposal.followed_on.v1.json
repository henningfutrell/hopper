{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposalId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "followOns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pathId": {
            "type": "string"
          },
          "jobId": {
            "type": "string"
          }
        },
        "required": [
          "pathId",
          "jobId"
        ],
        "additionalProperties": false
      }
    },
    "priority": {
      "type": "number"
    },
    "high": {
      "type": "boolean"
    }
  },
  "required": [
    "proposalId",
    "version",
    "followOns"
  ],
  "additionalProperties": false
}
