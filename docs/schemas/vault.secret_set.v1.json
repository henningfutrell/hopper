{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "replaced": {
      "type": "boolean"
    },
    "backend": {
      "type": "string"
    },
    "mints": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "cluster",
            "namespace",
            "argocd-app",
            "terraform-workspace",
            "aws-account",
