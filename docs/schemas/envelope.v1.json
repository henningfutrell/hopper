{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "seq": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "type": {
      "type": "string",
      "enum": [
        "job.queued",
        "job.prioritized",
        "job.held",
        "job.approved",
        "job.claimed",
        "job.started",
        "job.progressed",
        "job.finished",
        "job.failed",
        "job.cancelled",
        "job.requeued",
        "job.reattached",
        "job.reprioritized",
        "lane.opened",
        "lane.closed",
        "decision.made",
        "question.asked",
        "question.escalated",
        "question.escalated_to_human",
        "question.answered",
        "question.closed",
        "question.dismissed",
        "question.expired",
        "update.available",
        "update.started",
        "update.applied",
        "update.failed",
        "plugin.installed",
        "plugin.removed",
        "job.accepted",
        "job.rejected",
        "queue.ordered",
        "queue.gate_changed",
        "job.claimed_by_operator",
        "job.rerun",
        "job.dismissed",
        "job.unassigned",
        "job.reassigned",
        "source.stalled",
        "connected_account.expired",
        "jev.mode_changed",
        "router.mode_changed"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "jobId": {
      "type": "string"
    },
    "laneId": {
      "type": "string"
    },
    "machineId": {
      "type": "string"
    },
    "decisionId": {
      "type": "string"
    },
    "questionId": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "seq",
    "id",
    "type",
    "at",
    "data"
  ],
  "additionalProperties": false
}
