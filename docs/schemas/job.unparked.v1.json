{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "to": {
      "type": "string",
      "enum": [
        "queued",
        "waiting_answer"
      ]
    },
    "elsewhere": {
      "type": "boolean",
      "const": true
    },
    "by": {
      "type": "string"
    },
    "via": {
      "type": "string",
      "enum": [
        "ui",
        "cli",
        "api",
        "job"
      ]
    }
  },
  "required": [
