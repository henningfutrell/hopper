{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "write",
        "sync",
        "apply",
        "observe"
      ]
    },
    "asset": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "cluster",
            "namespace",
            "argocd-app",
            "terraform-workspace",
            "aws-account",
            "aws-role",
            "database"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "by": {
      "type": "string"
    }
  },
  "required": [
    "operation",
    "asset",
    "by"
  ],
  "additionalProperties": false
}
