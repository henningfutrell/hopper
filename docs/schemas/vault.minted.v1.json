{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "aws",
        "kube"
      ]
    },
    "operation": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "sync",
        "apply",
        "observe"
      ]
    },
    "asset": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "cluster",
            "namespace",
            "argocd-app",
            "terraform-workspace",
            "aws-account",
            "aws-role",
            "database"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "template": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "job": {
      "type": "string"
    },
    "credential": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    },
    "renewal": {
      "type": "boolean"
    },
    "plan": {
      "type": "string"
    },
    "principal": {
      "type": "string"
    },
    "bound": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "secret"
      ],
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "resource"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "operation",
    "asset",
    "template",
    "machine",
    "job",
    "credential",
    "decision",
    "expiresAt",
    "renewal"
  ],
  "additionalProperties": false
}
