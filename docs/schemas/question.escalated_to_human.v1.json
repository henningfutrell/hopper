{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questionId": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "jobId": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "answerUrl": {
      "type": "string"
    },
    "notifyCount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "lapsesAt": {
      "type": "string"
    },
    "tldr": {
      "type": "string"
    },
    "raisedBy": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "laneId": {
          "type": "string"
        }
      },
      "required": [
        "machineId"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "number"
    },
    "high": {
      "type": "boolean"
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "guard",
              "high_priority",
              "auto_answer_off",
              "low_confidence"
            ]
          },
          "by": {
            "type": "string",
            "enum": [
              "risk",
              "guard"
            ]
          },
          "guards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "threshold": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "questionId",
    "reason",
    "text",
    "jobId",
    "answerUrl",
    "notifyCount"
  ],
  "additionalProperties": false
}
