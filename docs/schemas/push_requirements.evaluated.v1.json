{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "base": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "default",
              "repo",
              "path",
              "job"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "reason": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "run": {
                  "type": "string"
                },
                "exit": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "thresholds": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "measured": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "number"
                  }
                },
                "passed": {
                  "type": "boolean"
                },
                "problem": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "run",
                "exit",
                "passed"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "level",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "repo",
    "branch",
    "base",
    "head",
    "passed",
    "requirements"
  ],
  "additionalProperties": false
}
