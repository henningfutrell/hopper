{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "enum": [
        "running",
        "waiting_answer"
      ]
    },
    "machineId": {
      "type": "string"
    },
    "auto": {
      "type": "boolean",
      "const": true
    },
    "why": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "via": {
      "type": "string",
      "enum": [
        "ui",
        "cli",
        "api"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "from"
  ],
  "additionalProperties": false
}
