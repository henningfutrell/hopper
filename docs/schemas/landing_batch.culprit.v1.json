{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string"
    },
    "tested": {
      "type": "string"
    },
    "tip": {
      "type": "string"
    },
    "index": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "sha": {
      "type": "string"
    },
    "pullRequest": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "reason": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sha": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "good",
              "bad",
              "unknown"
            ]
          }
        },
        "required": [
          "index",
          "sha",
          "outcome"
        ],
        "additionalProperties": false
      }
    },
    "batch": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "repo",
    "tested",
    "tip",
    "index",
    "sha",
    "checks",
    "reason",
    "results"
  ],
  "additionalProperties": false
}
