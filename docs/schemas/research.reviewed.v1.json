{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "researchId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "raisedBy": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "laneId": {
          "type": "string"
        }
      },
      "required": [
        "machineId"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "number"
    },
    "high": {
      "type": "boolean"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "request_changes",
        "escalate"
      ]
    },
    "notes": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "paths": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notViable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "added",
        "notViable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "researchId",
    "version",
    "stage",
    "verdict",
    "notes"
  ],
  "additionalProperties": false
}
