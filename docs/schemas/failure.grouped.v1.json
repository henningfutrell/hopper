{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "problemId": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "opened": {
      "type": "boolean"
    },
    "general": {
      "type": "boolean"
    },
    "decision": {
      "type": "string",
      "enum": [
        "hold",
        "redirect"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string"
        },
        "executor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "affected": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "problemId",
    "signature",
    "title",
    "opened",
    "general",
    "decision",
    "scope",
    "affected"
  ],
  "additionalProperties": false
}
