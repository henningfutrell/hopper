{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "forkId": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "research",
        "proposal"
      ]
    },
    "questionId": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept",
        "reject"
      ]
    },
    "delivered": {
      "type": "boolean"
    }
  },
  "required": [
    "forkId",
    "kind",
    "questionId",
    "decision",
    "delivered"
  ],
  "additionalProperties": false
}
