{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "noteIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delivery": {
      "type": "string",
      "enum": [
        "start",
        "turn",
        "resume"
      ]
    }
  },
  "required": [
    "noteIds",
    "delivery"
  ],
  "additionalProperties": false
}
