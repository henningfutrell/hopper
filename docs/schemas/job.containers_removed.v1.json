{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "containers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "startedAt": {
            "type": "string"
          },
          "stoppedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "image"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "containers",
    "volumes"
  ],
  "additionalProperties": false
}
