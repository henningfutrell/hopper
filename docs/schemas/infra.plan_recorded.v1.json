{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "plan": {
      "type": "string"
    },
    "tool": {
      "type": "string",
      "enum": [
        "terraform",
        "helm",
        "gitops"
      ]
    },
    "asset": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "cluster",
            "namespace",
            "argocd-app",
            "terraform-workspace",
            "aws-account",
            "aws-role",
            "database"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "pullRequest": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "read": {
      "type": "string"
    },
    "issue": {
      "type": "string"
    },
    "file": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "summary": {
      "type": "object",
      "properties": {
        "words": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "low",
            "high"
          ]
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "destroy",
              "iam",
              "prod",
              "data",
              "network"
            ]
          }
        },
        "failed": {
          "type": "boolean"
        }
      },
      "required": [
        "words",
        "level",
        "risks",
        "failed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "plan",
    "tool",
    "asset",
    "target",
    "repo",
    "ref",
    "commit",
    "file",
    "expiresAt"
  ],
  "additionalProperties": false
}
