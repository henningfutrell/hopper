{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "fromHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "editors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "key",
    "fromHash",
    "toHash",
    "editors"
  ],
  "additionalProperties": false
}
