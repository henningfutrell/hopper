{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "paths": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasons": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "dirty",
            "stash",
            "unpushed"
          ]
        }
      }
    }
  },
  "required": [
    "paths"
  ],
  "additionalProperties": false
}
