{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "machineId": {
      "type": "string"
    },
    "lanes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "configured": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headroom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "usage": {
      "type": "string",
      "enum": [
        "free",
        "near",
        "soft",
        "hard"
      ]
    },
    "mode": {
      "type": "string",
      "const": "shadow"
    },
    "decidedBy": {
      "type": "string",
      "const": "jev"
    },
    "rules": {
      "type": "object",
      "properties": {
        "lanes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "lanes",
        "reason",
        "confidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "machineId",
    "lanes",
    "configured",
    "reason",
    "confidence",
    "usage"
  ],
  "additionalProperties": false
}
