          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "job"
            },
            "jobId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "jobId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "item"
            },
            "repo": {
              "type": "string"
            },
            "number": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "number"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
