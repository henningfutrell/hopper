            },
            "questionId": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "questionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "approval"
