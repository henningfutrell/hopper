{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "by": {
      "type": "string"
    },
    "step": {
      "type": "string",
      "enum": [
        "queued",
        "coding",
        "pr_checks",
        "landing",
        "landing_checks",
        "promotion_set",
        "test_gate",
        "production"
      ]
    },
    "owner": {
      "type": "string",
      "enum": [
        "hopper",
        "person"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "by",
    "step",
    "owner"
  ],
  "additionalProperties": false
}
