{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "researchId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "raisedBy": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "laneId": {
          "type": "string"
        }
      },
      "required": [
        "machineId"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "number"
    },
    "high": {
      "type": "boolean"
    },
    "question": {
      "type": "string"
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "question",
          "findings",
          "sources",
          "confidence",
          "openThreads",
          "nextStep"
        ]
      }
    }
  },
  "required": [
    "researchId",
    "version",
    "missing"
  ],
  "additionalProperties": false
}
