      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "changed": {
