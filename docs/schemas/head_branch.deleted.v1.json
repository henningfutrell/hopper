{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "pullRequest": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "via": {
      "type": "string",
      "enum": [
        "merge",
        "sweep"
      ]
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "repo",
    "branch",
    "pullRequest",
    "head",
    "via",
    "source"
  ],
  "additionalProperties": false
}
