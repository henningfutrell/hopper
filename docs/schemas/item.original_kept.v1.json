{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "liveHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "person": {
      "type": "string"
    },
    "via": {
      "type": "string",
      "enum": [
        "ui",
        "cli"
      ]
    }
  },
  "required": [
    "key",
    "snapshotHash",
    "liveHash",
    "person",
    "via"
  ],
  "additionalProperties": false
}
