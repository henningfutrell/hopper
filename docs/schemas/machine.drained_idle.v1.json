      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "since": {
      "type": "string"
    },
    "drainedAt": {
      "type": "string"
    },
    "until": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
