{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "host": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "repo": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "not_listed",
        "local_address"
      ]
    }
  },
  "required": [
    "host",
    "port",
    "reason"
  ],
  "additionalProperties": false
}
