{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string"
    },
    "tested": {
      "type": "string"
    },
    "tip": {
      "type": "string"
    },
    "pullRequest": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "url": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "boolean"
    },
    "cutOff": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "repo",
    "tested",
    "tip",
    "pullRequest",
    "url",
    "reason",
    "checks"
  ],
  "additionalProperties": false
}
