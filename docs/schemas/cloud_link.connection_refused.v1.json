{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "installId": {
      "type": "string"
    },
    "account": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "pin",
        "tls",
        "http",
        "too-many",
        "bad-hello",
        "unknown-key",
        "hello-timeout"
      ]
    }
  },
  "required": [
    "installId",
    "account",
    "reason"
  ],
  "additionalProperties": false
}
