{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "from": {
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "finished",
              "failed",
              "cancelled"
            ]
          }
        },
        "multiJob": {
          "type": "boolean"
        },
        "minRunMinutes": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "on",
        "outcomes",
        "multiJob",
        "minRunMinutes"
      ],
      "additionalProperties": false
    },
    "to": {
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "finished",
              "failed",
              "cancelled"
            ]
          }
        },
        "multiJob": {
          "type": "boolean"
        },
        "minRunMinutes": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "on",
        "outcomes",
        "multiJob",
        "minRunMinutes"
      ],
      "additionalProperties": false
    },
    "by": {
      "type": "string"
    }
  },
  "required": [
    "from",
    "to",
    "by"
  ],
  "additionalProperties": false
}
