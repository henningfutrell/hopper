{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "step": {
      "type": "string"
    },
    "host": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "inputsBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "step",
    "host",
    "command",
    "timeoutSeconds",
    "inputsBytes",
    "outputs"
  ],
  "additionalProperties": false
}
