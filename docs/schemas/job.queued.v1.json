{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "executor": {
          "type": "string"
        },
        "payload": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "priority": {
          "type": "number"
        },
        "goal": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "submittedBy": {
          "type": "string"
        },
        "machineId": {
          "type": "string"
        },
        "meta": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "routedBy": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string"
            },
            "set": {
              "type": "object",
              "properties": {
                "machine": {
                  "type": "string"
                },
                "executor": {
                  "type": "string"
                },
                "priority": {
                  "type": "number"
                },
                "workTree": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "rule",
            "set"
          ],
          "additionalProperties": false
        },
        "proposal": {
          "type": "boolean",
          "const": true
        },
        "research": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "executor",
        "payload"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "number"
    },
    "source": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "author": {
          "type": "string"
        },
        "assignee": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "source",
        "kind",
        "key"
      ],
      "additionalProperties": false
    },
    "forkOf": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "questionId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "research",
            "proposal"
          ]
        }
      },
      "required": [
        "jobId",
        "questionId",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "spec",
    "priority"
  ],
  "additionalProperties": false
}
