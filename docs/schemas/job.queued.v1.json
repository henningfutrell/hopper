{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "executor": {
          "type": "string"
        },
        "payload": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "priority": {
          "type": "number"
        },
        "goal": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "submittedBy": {
          "type": "string"
        },
        "machineId": {
          "type": "string"
        },
        "meta": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "routedBy": {
          "type": "object",
          "properties": {
            "rule": {
              "type": "string"
            },
            "set": {
              "type": "object",
              "properties": {
                "machine": {
                  "type": "string"
                },
                "executor": {
                  "type": "string"
                },
                "priority": {
                  "type": "number"
                },
                "workTree": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "rule",
            "set"
          ],
          "additionalProperties": false
        },
        "proposal": {
          "type": "boolean",
          "const": true
        },
        "research": {
          "type": "boolean",
          "const": true
        },
        "specialty": {
          "type": "boolean",
          "const": true
        },
        "tend": {
          "type": "boolean",
          "const": true
        },
        "modelRoute": {
          "type": "object",
          "properties": {
            "choice": {
              "type": "string",
              "enum": [
                "cheap",
                "strong"
              ]
            },
            "model": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            },
            "why": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "enum": [
                "small",
                "large"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "code",
                "research",
                "proposal",
                "tend"
              ]
            },
            "risk": {
              "type": "string",
              "enum": [
                "low",
                "high"
              ]
            },
            "budget": {
              "type": "object",
              "properties": {
                "jobTokens": {
                  "type": "number"
                },
                "jobCostUsd": {
                  "type": "number"
                }
              },
              "required": [
                "jobTokens",
                "jobCostUsd"
              ],
              "additionalProperties": false
            },
            "escalated": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "enum": [
                    "cheap",
                    "strong"
                  ]
                },
                "jobId": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "jobId"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "choice",
            "model",
            "rule",
            "why",
            "size",
            "kind",
            "risk",
            "budget"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "executor",
        "payload"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "number"
    },
    "source": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "author": {
          "type": "string"
        },
        "assignee": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "type": "string",
          "enum": [
            "trusted",
            "approved"
          ]
        },
        "originActs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "author",
                  "labelled",
                  "assigned",
                  "edited",
                  "nominated"
                ]
              },
              "login": {
                "type": "string"
              },
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "app": {
                "type": "string"
              },
              "trusted": {
                "type": "boolean"
              }
            },
            "required": [
              "role",
              "trusted"
            ],
            "additionalProperties": false
          }
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private",
            "internal"
          ]
        },
        "linkedPulls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "fork": {
                "type": "boolean"
              },
              "trusted": {
                "type": "boolean"
              },
              "unread": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "url",
              "trusted"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "source",
        "kind",
        "key"
      ],
      "additionalProperties": false
    },
    "forkOf": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "questionId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "research",
            "proposal"
          ]
        }
      },
      "required": [
        "jobId",
        "questionId",
        "kind"
      ],
      "additionalProperties": false
    },
    "followOn": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "proposalId": {
          "type": "string"
        },
        "pathId": {
          "type": "string"
        }
      },
      "required": [
        "jobId",
        "proposalId",
        "pathId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "spec",
    "priority"
  ],
  "additionalProperties": false
}
