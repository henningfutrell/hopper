{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "paths": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discarded": {
      "type": "boolean",
      "const": true
    },
    "gone": {
      "type": "boolean",
      "const": true
    },
    "reason": {
      "type": "string",
      "enum": [
        "merged",
        "superseded",
        "proposal",
        "research"
      ]
    },
    "person": {
      "type": "string"
    },
    "via": {
      "type": "string",
      "enum": [
        "ui",
        "cli",
        "api"
      ]
    }
  },
  "required": [
    "paths"
  ],
  "additionalProperties": false
}
