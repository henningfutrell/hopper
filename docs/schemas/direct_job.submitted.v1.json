{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "via": {
      "type": "string",
      "enum": [
        "ui",
        "cli",
        "api"
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorizations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repo": {
      "type": "string"
    },
    "pushRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "by",
    "via",
    "labels",
    "authorizations"
  ],
  "additionalProperties": false
}
