{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pickId": {
      "type": "string"
    },
    "point": {
      "type": "string",
      "enum": [
        "question-risk",
        "failure-assessment",
        "lane-count",
        "job-machine",
        "intake-order",
        "merge-order",
        "intake-trust",
        "intake-kind",
        "sandbox-request",
        "question-answer"
      ]
    },
    "pick": {
      "type": "string"
    },
    "actual": {
      "type": "string"
    },
    "agreed": {
      "type": "boolean"
    },
    "decidedBy": {
      "type": "string"
    }
  },
  "required": [
    "pickId",
    "point",
    "pick",
    "actual",
    "agreed",
    "decidedBy"
  ],
  "additionalProperties": false
}
