{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "template": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "sync",
              "apply"
            ]
          },
          "asset": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "cluster",
                  "namespace",
                  "argocd-app",
                  "terraform-workspace",
                  "aws-account",
                  "aws-role"
                ]
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "operation",
          "asset"
        ],
        "additionalProperties": false
      }
    },
    "by": {
      "type": "string"
    }
  },
  "required": [
    "template",
    "image",
    "secrets",
    "by"
  ],
  "additionalProperties": false
}
