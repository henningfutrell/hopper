{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "template": {
      "type": "string"
    },
    "asset": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "repoCopy": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "tree": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "tree",
        "commit",
        "changed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "requestId",
    "skill"
  ],
  "additionalProperties": false
}
