{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pullRequest": {
      "type": "string"
    },
    "part": {
      "type": "boolean"
    },
    "byHopper": {
      "type": "boolean",
      "const": true
    },
    "person": {
      "type": "string"
    },
    "via": {
      "type": "string",
      "enum": [
        "ui",
        "cli"
      ]
    }
  },
  "required": [
    "pullRequest",
    "part"
  ],
  "additionalProperties": false
}
