{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entry": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "convention",
        "fix"
      ]
    },
    "area": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "proposed",
        "approved"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "again": {
      "type": "boolean"
    }
  },
  "required": [
    "entry",
    "repo",
    "kind",
    "text",
    "state",
    "confidence",
    "again"
  ],
  "additionalProperties": false
}
