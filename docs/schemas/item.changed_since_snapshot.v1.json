{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "liveHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "editors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "newComments": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "key",
    "snapshotHash",
    "liveHash",
    "editors",
    "newComments"
  ],
  "additionalProperties": false
}
