{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "recordId": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "class": {
      "type": "string",
      "enum": [
        "transient",
        "shared",
        "job"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "retry",
        "hold",
        "redirect",
        "person",
        "continue"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "auto": {
      "type": "boolean"
    },
    "causeId": {
      "type": "string"
    },
    "problemId": {
      "type": "string"
    },
    "retryAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "priority": {
      "type": "number"
    },
    "high": {
      "type": "boolean"
    }
  },
  "required": [
    "recordId",
    "signature",
    "class",
    "decision",
    "reasons",
    "summary",
    "attempt",
    "auto"
  ],
  "additionalProperties": false
}
