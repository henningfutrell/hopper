{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pullRequest": {
      "type": "string"
    },
    "step": {
      "type": "string",
      "enum": [
        "rebase",
        "fix_checks"
      ]
    },
    "nextJobId": {
      "type": "string"
    }
  },
  "required": [
    "pullRequest",
    "step",
    "nextJobId"
  ],
  "additionalProperties": false
}
