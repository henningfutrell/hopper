{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "why": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "done": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "checks-passed"
                    },
                    "checks": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "checks"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "plan-destroy"
                    },
                    "checks": {
                      "type": "string"
                    },
                    "max": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "name",
          "version",
          "seq",
          "why",
          "done"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "skills"
  ],
  "additionalProperties": false
}
