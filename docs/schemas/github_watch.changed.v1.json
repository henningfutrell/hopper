{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pointedJob": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "pointer": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "issue",
            "pull_request"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "number",
        "url"
      ],
      "additionalProperties": false
    },
    "changes": {
      "type": "object",
      "properties": {
        "state": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "merged"
              ]
            },
            "to": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "merged"
              ]
            },
            "reason": {
              "type": "string"
            },
            "mergedAt": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "labels": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "added",
            "removed"
          ],
          "additionalProperties": false
        },
        "comments": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "author": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "author",
                  "at"
                ],
                "additionalProperties": false
              }
            },
            "removed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "added",
            "removed"
          ],
          "additionalProperties": false
        },
        "reviews": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "author": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "author",
                  "at",
                  "state"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "added"
          ],
          "additionalProperties": false
        },
        "linkedPullRequests": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "removed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "added",
            "removed"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "pointedJob",
    "repo",
    "pointer",
    "changes"
  ],
  "additionalProperties": false
}
