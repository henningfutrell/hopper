{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string"
    },
    "pullRequest": {
      "type": "string"
    },
    "head": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "minutes": {
      "type": "number"
    }
  },
  "required": [
    "repo",
    "pullRequest",
    "head",
    "checks",
    "requirements"
  ],
  "additionalProperties": false
}
