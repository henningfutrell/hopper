{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questionId": {
      "type": "string"
    },
    "by": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string"
    },
    "via": {
      "type": "string",
      "const": "pane"
    },
    "auto": {
      "type": "boolean",
      "const": true
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "raisedBy": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "laneId": {
          "type": "string"
        }
      },
      "required": [
        "machineId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "questionId",
    "by",
    "answer"
  ],
  "additionalProperties": false
}
