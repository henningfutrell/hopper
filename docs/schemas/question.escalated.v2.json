{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questionId": {
      "type": "string"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "jobId": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "answerUrl": {
      "type": "string"
    },
    "notifyCount": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "renotify": {
      "type": "boolean"
    },
    "lapsesAt": {
      "type": "string"
    },
    "tldr": {
      "type": "string"
    },
    "raisedBy": {
      "type": "object",
      "properties": {
        "machineId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "laneId": {
          "type": "string"
        }
      },
      "required": [
        "machineId"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "number"
    },
    "high": {
      "type": "boolean"
    }
  },
  "required": [
    "questionId",
    "target",
    "reason",
    "text",
    "jobId"
  ],
  "additionalProperties": false
}
