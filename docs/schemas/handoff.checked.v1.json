{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "handoffId": {
      "type": "string"
    },
    "item": {
      "type": "string",
      "enum": [
        "open",
        "done",
        "closed",
        "gone"
      ]
    },
    "pullRequests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "shipped": {
      "type": "boolean"
    }
  },
  "required": [
    "handoffId",
    "item",
    "pullRequests",
    "shipped"
  ],
  "additionalProperties": false
}
