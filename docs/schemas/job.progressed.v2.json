  "properties": {
    "message": {
      "type": "string"
    },
    "tasks": {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
