{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string"
    },
    "machine": {
      "type": "string"
    },
    "as": {
      "type": "string"
    },
    "own": {
      "type": "boolean"
    },
    "forUser": {
      "type": "string"
    },
    "job": {
      "type": "string"
    },
    "op": {
      "type": "string",
      "enum": [
        "issue.create",
        "issue.comment",
        "pr.create"
      ]
    },
    "repo": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "key": {
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "op",
    "repo",
    "key"
  ],
  "additionalProperties": false
}
