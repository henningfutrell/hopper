[Unit]
Description=hopper client: this machine as a client target of a hopper, dialing it over ssh (design.md "Client targets")
Wants=hopper-client-herdr.service
After=network-online.target hopper-client-herdr.service

[Service]
Type=simple
ExecStart=/usr/bin/env node %h/.local/lib/hopper-client/main.ts
# Written by scripts/attach-client.sh (mode 600): the token and key files, the hopper, this machine's herdr and session.
EnvironmentFile=%h/.config/hopper-client/client.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# The panes herdr opens must not inherit a Claude child-session marker.
UnsetEnvironment=CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SSE_PORT CLAUDE_CODE_CHILD_SESSION
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true

[Install]
WantedBy=default.target
