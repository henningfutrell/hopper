[Unit]
Description=job-hopper local job-queue daemon (127.0.0.1:4790; LAN names from daemon.env)
Wants=job-hopper-herdr.service
After=default.target job-hopper-herdr.service

[Service]
Type=simple
ExecStart=/usr/bin/node %h/.local/lib/job-hopper/src/main.ts
Environment=JOB_HOPPER_PORT=4790
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# Process settings only. Every part — job sources (the GitHub App via
# %h/.config/job-hopper/github-app.json, or the gh CLI), executors, router, answerer, assessor, the
# machine and its lanes — is configured in plugins.yaml, which the daemon writes (mode 600) on the
# first boot without one. It sends webhooks (webhooks.yaml). The UI login code is written to
# %h/.local/share/job-hopper/ui-login-code.
Environment=JOB_HOPPER_PLUGINS_FILE=%h/.config/job-hopper/plugins.yaml
Environment=JOB_HOPPER_WEBHOOKS_FILE=%h/.config/job-hopper/webhooks.yaml
# Optional, this machine's: JOB_HOPPER_LAN_NAMES and JOB_HOPPER_LAN_PEERS to reach the UI across the
# LAN (docs/design.md "Reaching the UI across the LAN"), JOB_HOPPER_PUBLIC_URL behind a reverse proxy.
# Absent: loopback only. Sign-in (login code, OIDC, GitHub, SAML): %h/.config/job-hopper/auth.yaml,
# read at start (docs/sign-in.md).
EnvironmentFile=-%h/.config/job-hopper/daemon.env
Restart=on-failure
RestartSec=2
# Self-update (design.md "Self-update"): exit 75 means "start me again on the new install".
SuccessExitStatus=75
RestartForceExitStatus=75
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
