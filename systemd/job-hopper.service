[Unit]
Description=job-hopper local job-queue daemon (loopback-only, 127.0.0.1:4790)
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/node %h/.local/lib/job-hopper/src/main.ts
Environment=JOB_HOPPER_HOST=127.0.0.1
Environment=JOB_HOPPER_PORT=4790
Environment=JOB_HOPPER_JEV_ADVISOR=router
Environment=JOB_HOPPER_JEV_MODE=shadow
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
