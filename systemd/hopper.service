[Unit]
Description=hopper local job-queue daemon (127.0.0.1:4790; LAN names from daemon.env)
Wants=hopper-herdr.service
After=default.target hopper-herdr.service

[Service]
Type=simple
ExecStart=/usr/bin/node %h/.local/lib/hopper/src/main.ts
Environment=HOPPER_PORT=4790
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# Process settings only. Every part — job sources, executors, router, escalation levels, the machine
# and its lanes — and sign-in are configured in the UI and kept in the database (docs/design.md
# "Config in the database"); there is no config file.
# daemon.env, this machine's (written by install.sh, mode 600): HOPPER_DATABASE_URL (required),
# the secrets (docs/design.md "Secrets"), and optionally HOPPER_LAN_NAMES and HOPPER_LAN_PEERS
# to reach the UI across the LAN, HOPPER_PUBLIC_URL behind a reverse proxy.
EnvironmentFile=%h/.config/hopper/daemon.env
# Scratch only (claude's working directory, ssh sockets, the update mirror): this user's cache dir.
Environment=HOPPER_WORK_DIR=%C/hopper
Restart=on-failure
RestartSec=2
# Self-update (design.md "Self-update"): exit 75 means "start me again on the new install".
SuccessExitStatus=75
RestartForceExitStatus=75
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
# Docker only through a socket the daemon alone may open (HOPPER_DOCKER_HOST, a socket proxy:
# scripts/docker-proxy.sh), never the root daemon's: whoever opens that one is root here (issue #59).
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock

[Install]
WantedBy=default.target
