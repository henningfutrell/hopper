{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "GET",
        "urlPath": "/api/widgets",
        "headers": { "Authorization": { "matches": "^Bearer (__KEY1__|__KEY2__)$" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "widgets": [
            { "id": "w-001", "name": "Sprocket", "color": "teal", "stock": 42 },
            { "id": "w-002", "name": "Gizmo", "color": "amber", "stock": 7 },
            { "id": "w-003", "name": "Doohickey", "color": "violet", "stock": 0 }
          ],
          "preset": "hopper-sse-e2e"
        }
      }
    },
    {
      "priority": 10,
      "request": { "method": "GET", "urlPath": "/api/widgets" },
      "response": { "status": 401, "headers": { "Content-Type": "application/json" }, "jsonBody": { "error": "unauthorized" } }
    }
  ]
}
