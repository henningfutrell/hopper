# job-hopper's environment in a container (docs/deploy.md). Copy to deploy/hopper.env, mode 600.
# Process settings are JOB_HOPPER_* variables; every part is configured in plugins.yaml, a config
# document in the database (the UI, or: docker compose exec hopper job-hopper config edit plugins.yaml).

# How the UI is reached. Behind a reverse proxy: its public origin, and the range the proxy's requests
# come from (the compose network). Without either the daemon answers loopback only — inside the
# container, so nothing outside it could reach the UI.
JOB_HOPPER_PUBLIC_URL=https://hopper.example.com
JOB_HOPPER_LAN_PEERS=172.16.0.0/12

# Secrets (docs/design.md "Secrets"). The hopper keeps none itself: each comes from here, or from a
# mounted secret file — set NAME_FILE=/run/secrets/<file> instead of NAME (never both). Leave out what
# you do not use.
# GitHub: one of the two (README "Connect GitHub").
# Default, the gh CLI (github-gh job source), as you: a token for your account (`gh auth token`).
GH_TOKEN=
# Or this hopper's own GitHub App: its private key, newlines as \n
# (scripts/create-github-app.sh --secrets-file writes this line). Never another hopper's key.
GITHUB_APP_PRIVATE_KEY=
# The claude CLI (answerer, assessor, usage reading): a subscription token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Grok Bot routine (grokbot-routine notifier).
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=
# Jev's TypeSafe gates.
TYPESAFE_API_KEY=
# Target authentication (docs/design.md "Target authentication"): the hopper's ssh key for ssh targets
# (a mounted file only: ssh reads keys from files), its docker socket for container targets (a socket
# only its user may open, scripts/docker-proxy.sh), and each client target's token (the variable its
# plugins.yaml entry's tokenEnv names, or <it>_FILE).
# JOB_HOPPER_SSH_KEY_FILE=/run/secrets/hopper_ssh_key
# JOB_HOPPER_DOCKER_HOST=unix:///run/job-hopper/docker.sock
# CLIENT_TOKEN_STUDIO_FILE=/run/secrets/client_token_studio
# Each webhook subscription's signing secret, in the variable its secretEnv names (the UI suggests
# WEBHOOK_SECRET_<NAME>): openssl rand -hex 32, given to the subscriber too.
# WEBHOOK_SECRET_GROK_BOT=
