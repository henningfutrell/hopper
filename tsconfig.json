{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "cloud", "test", "scripts", "examples", "vitest.config.ts", "vitest.cloud.config.ts", "eslint.config.js"],
  "exclude": ["test/e2e/sse-vault-wiremock", "**/node_modules", ".worktrees", "**/@scratch"]
}
