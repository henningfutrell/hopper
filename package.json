{
  "name": "job-hopper",
  "version": "0.1.0",
  "private": true,
  "description": "Local job-queue daemon: one decider engine over machines, lanes, usage budgets and the queue, with Jev as admission layer.",
  "type": "module",
  "exports": {
    "./plugin": "./src/plugins/sdk.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "schemas": "node scripts/export-schemas.ts",
    "plugin:check": "node scripts/plugin-check.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:ui",
    "build:ui": "vite build --config ui/vite.config.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@node-saml/node-saml": "^5.1.0",
    "@octokit/auth-app": "^8.3.1",
