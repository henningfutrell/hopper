{
  "name": "job-hopper",
  "version": "0.1.0",
  "private": true,
  "description": "Local job-queue daemon: one decider engine over machines, lanes, usage budgets and the queue, with Jev as admission layer.",
  "type": "module",
  "exports": {
    "./plugin": "./src/plugins/sdk.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "schemas": "node scripts/export-schemas.ts",
    "plugin:check": "node scripts/plugin-check.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/request": "^10.0.16",
    "fastify": "^5.12.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
