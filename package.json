{
  "name": "hopper",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Local job-queue daemon: one decider engine over machines, lanes, usage budgets and the queue, with a router as admission layer.",
  "type": "module",
  "exports": {
    "./plugin": "./src/plugins/sdk.ts"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "start": "node src/main.ts",
    "cloud": "node cloud/main.ts",
    "test": "vitest run",
    "test:e2e:sse-vault": "bash test/e2e/sse-vault-wiremock/run.sh",
    "test:cloud": "vitest run --config vitest.cloud.config.ts",
    "test:crash": "vitest run --config vitest.crash.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json && tsc -p site/tsconfig.json",
    "schemas": "node scripts/export-schemas.ts",
    "plugin:check": "node scripts/plugin-check.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:ui",
    "build:site": "vite build --config site/vite.config.ts",
    "build:ui": "vite build --config ui/vite.config.ts && node scripts/copy-artifact-libs.ts ui/dist && node scripts/check-ui-bundle.ts ui/dist",
    "screenshots": "node scripts/screenshots/capture.ts"
  },
